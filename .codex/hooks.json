{
  "description": "Format TypeScript files after Codex edits them.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/format-typescript.mjs\"",
            "timeout": 30,
            "statusMessage": "Formatting edited TypeScript files"
          }
        ]
      }
    ]
  }
}
